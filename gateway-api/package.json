{
  "name": "@pythia/gateway-api",
  "version": "0.1.0",
  "private": true,
  "description": "Dual-Loop gateway: REST + WSS bridge between bus (Redis/NATS) and Command Center UI",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "bcryptjs": "^2.4.3",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "nats": "^2.29.1",
    "paseto-ts": "^2.0.6",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "bun-types": "^1.3.11",
    "ioredis-mock": "^8.9.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.0.0"
  }
}
