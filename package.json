{
  "name": "pythia",
  "version": "1.0.0",
  "description": "Autonomous Polymarket prediction intelligence system",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "day0": "bash scripts/day0_check.sh",
    "check-edge": "cd python && python3 edge_calculator.py",
    "analyze": "cd python && python3 analyze.py",
    "db:pg:generate": "drizzle-kit generate",
    "db:pg:push": "drizzle-kit push",
    "db:pg:migrate": "drizzle-kit migrate",
    "db:parity": "bun run src/services/db_parity.ts",
    "db:pg:initial-load": "bun run scripts/pg_initial_load.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "openai": "^4.80.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.0"
  }
}
