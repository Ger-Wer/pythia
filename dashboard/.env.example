# Copy to `.env` (or `.env.local`) and tweak.

# Dual-Loop Command Center (Phase 1 / Track C).
# When "true" or "1" — /command-center renders fully and shows in navigation.
# When unset/false — route is accessible only via `/command-center?preview=1`.
VITE_DUAL_LOOP_UI_ENABLED=true

# Optional: real gateway WSS URL for Phase 2+. Leave unset in Phase 1 to use
# the in-browser mock feed (simulated signals / triggers / latency).
# VITE_COMMAND_CENTER_WS_URL=ws://127.0.0.1:8787/ws/v1

# Optional auth/debug helpers for Phase 2-E:
# - token can also be supplied at runtime via /command-center?token=...
# - cc_debug=1 in the page URL enables client-side WS logs without rebuilding.
# VITE_COMMAND_CENTER_WS_TOKEN=
# VITE_COMMAND_CENTER_WS_DEBUG=false
