# Pythia v2: collect, paper-test the complete channel loop, analyze and check work.
# All times UTC. Paper job is explicitly opt-in and cannot submit live orders.
0 8 * * * /app/scripts/entrypoint.sh snapshot >> /app/logs/tracker.log 2>&1
15 8 * * * /app/scripts/entrypoint.sh paper-cycle >> /app/logs/paper.log 2>&1
25 8 * * * /app/scripts/entrypoint.sh paper-link >> /app/logs/paper-link.log 2>&1
0 9 * * 0 /app/scripts/entrypoint.sh analyze >> /app/logs/analysis.log 2>&1
0 20 * * * /app/scripts/entrypoint.sh healthcheck >> /app/logs/healthcheck.log 2>&1
