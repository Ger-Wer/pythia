# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OR use OpenRouter instead:
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI (for dual-LLM ensemble, see Phase 5)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional: Override base URLs
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (DeepSeek V4 — deepseek-chat and deepseek-reasoner now route to V4-Flash)
MODEL_RESEARCH=deepseek-chat
MODEL_SYNTHESIS=deepseek-reasoner
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
MISTRAL_SMALL_MODEL=mistral-small-latest

# Search APIs (free tier)
# Brave Search — free 2k req/month, https://api.search.brave.com
BRAVE_SEARCH_API_KEY=
# SearXNG — self-hosted, leave empty if not running
SEARXNG_BASE_URL=
SEARXNG_SECRET_KEY=              # required by SearXNG container, generate with: openssl rand -hex 32

# Telegram Notifications (Private Bot - Operator Inbox)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Pythia Capital — Public Telegram Channel
ORACLE_TELEGRAM_BOT_TOKEN=your_oracle_bot_token_here
ORACLE_TELEGRAM_CHANNEL_ID=your_oracle_channel_id_here
ORACLE_CHANNEL_USERNAME=@pythiacap

# Oracle LLM Configuration (post formatting only; predictions use DeepSeek+Mistral ensemble)
ORACLE_LLM_PROVIDER=mistral
ORACLE_LLM_MODEL_REASONING=mistral-small-latest

# Oracle Publishing Configuration
ORACLE_MIN_EDGE=0.08
ORACLE_MIN_CONFIDENCE=0.60
ORACLE_MIN_VOLUME_USD=500000
ORACLE_MIN_DAYS_UNTIL_CLOSE=3
ORACLE_MAX_DAYS_UNTIL_CLOSE=45
ORACLE_EXCLUDE_CATEGORIES=
ORACLE_MAX_LLM_COST_PER_DAY=5.00
ORACLE_PICKS_PER_PUBLISH=5

# Dual-LLM Ensemble Configuration
ENSEMBLE_WEIGHT_DEEPSEEK=0.6
ENSEMBLE_WEIGHT_MISTRAL=0.4
ENSEMBLE_DISAGREEMENT_THRESHOLD=0.15

# Virtual Portfolio Configuration
PORTFOLIO_STARTING_AUM=1000
PORTFOLIO_KELLY_FRACTION=0.25
PORTFOLIO_MAX_POSITION_PCT=0.05

# Cost Limits
DAILY_COST_LIMIT_USD=2.00
MONTHLY_COST_LIMIT_USD=50.00
MARKETS_PER_RUN=20

# Paths
DB_PATH=./data/pythia.db
LOG_DIR=./logs

# Safety Pipeline Configuration
SAFETY_MAX_SIGNAL_AGE_SECONDS=30
SAFETY_PRICE_DRIFT_TOLERANCE=0.03
SAFETY_COOLDOWN_SECONDS=60
SAFETY_DEDUP_WINDOW_MINUTES=5

# ---------------------------------------------------------------------------
# Dual-Loop secrets (Track A3 — required before live trading)
#
# docker-compose.dev.yml ships dev fallbacks so a fresh `make dev-up` works
# without a .env file. For any deployment that publishes signals or accepts
# kill commands from the outside (i.e. amper, staging, prod), override these:
#
#   GATEWAY_PASETO_KEY=$(openssl rand -base64 32)
#   KILL_HMAC_SECRET=$(openssl rand -hex 32)
#   OPERATOR_PASSWORD_HASH=$(bun run -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" -- <password>)
#
# KILL_HMAC_SECRET MUST be identical for the gateway-api and sniper-executor
# containers — both sign/verify the kill envelope with it.
# ---------------------------------------------------------------------------
# GATEWAY_PASETO_KEY=
# KILL_HMAC_SECRET=
# OPERATOR_ID=admin
# OPERATOR_PASSWORD_HASH=

# Polygon fork URL for the local anvil dev node. Optional — when unset
# (or empty) anvil boots a fresh chain-id 137 dev node, which is enough
# for paper-mode E2E. Set this once we want to test against real
# Polymarket / UMA state. The free https://polygon-rpc.com public
# endpoint returns 401 "tenant disabled" so it is no longer a usable
# default; use Alchemy / Infura / QuickNode (all have free tiers).
# POLYGON_RPC_URL=
