# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OR use OpenRouter instead:
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override base URLs
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models
MODEL_RESEARCH=deepseek-chat
MODEL_SYNTHESIS=deepseek-reasoner

# Search APIs
EXA_API_KEY=your_exa_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Cost Limits
DAILY_COST_LIMIT_USD=2.00
MONTHLY_COST_LIMIT_USD=50.00
MARKETS_PER_RUN=20

# Paths
DB_PATH=./data/pythia.db
LOG_DIR=./logs

# Safety Pipeline Configuration
SAFETY_MAX_SIGNAL_AGE_SECONDS=30
SAFETY_PRICE_DRIFT_TOLERANCE=0.03
SAFETY_COOLDOWN_SECONDS=60
SAFETY_DEDUP_WINDOW_MINUTES=5

# ---------------------------------------------------------------------------
# Dual-Loop secrets (Track A3 — required before live trading)
#
# docker-compose.dev.yml ships dev fallbacks so a fresh `make dev-up` works
# without a .env file. For any deployment that publishes signals or accepts
# kill commands from the outside (i.e. amper, staging, prod), override these:
#
#   GATEWAY_PASETO_KEY=$(openssl rand -base64 32)
#   KILL_HMAC_SECRET=$(openssl rand -hex 32)
#   OPERATOR_PASSWORD_HASH=$(bun run -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" -- <password>)
#
# KILL_HMAC_SECRET MUST be identical for the gateway-api and sniper-executor
# containers — both sign/verify the kill envelope with it.
# ---------------------------------------------------------------------------
# GATEWAY_PASETO_KEY=
# KILL_HMAC_SECRET=
# OPERATOR_ID=admin
# OPERATOR_PASSWORD_HASH=
